{
  "name": "it-mentor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "conductor": "git+https://gitflic.ru/project/dev-ocrv/conductor-ui-kit.git#ui-kit/v2.2.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.38",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^5.1.2",
    "sass": "^1.98.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.1",
    "vue-tsc": "^2.0.29"
  }
}
